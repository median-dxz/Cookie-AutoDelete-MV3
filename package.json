{
  "name": "cookie-autodelete",
  "version": "4.0.0",
  "description": "Firefox and Chrome browser extension that manages Cookies and other site data",
  "keywords": [
    "cookie",
    "browser cookies",
    "browser webextension",
    "webextension",
    "extension"
  ],
  "engines": {
    "node": "^22.13.0 || >=24",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@reduxjs/toolkit": "^2.12.0",
    "bootstrap": "^5.3.8",
    "immer": "^11.1.18",
    "ipaddr.js": "^2.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "shortid": "^2.2.17",
    "webext-redux": "^4.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint-react/eslint-plugin": "^5.18.7",
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/bootstrap": "^5.2.11",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/shortid": "2.2.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "^6.1.1",
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-when": "^4.0.3",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.103.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "overrides": {
    "babel-plugin-istanbul": {
      "test-exclude": "^7.0.0"
    }
  },
  "scripts": {
    "dev:chrome": "cross-env BROWSER=chrome vite",
    "dev:firefox": "cross-env BROWSER=firefox vite",
    "compile:chrome": "cross-env BROWSER=chrome vite build",
    "compile:firefox": "cross-env BROWSER=firefox vite build",
    "package:chrome": "node ./tools/packageExtension.js chrome",
    "package:firefox": "node ./tools/packageExtension.js firefox",
    "build:chrome": "npm run compile:chrome && npm run package:chrome",
    "build:firefox": "npm run compile:firefox && npm run package:firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "lint": "eslint -c eslint.config.js --ext .ts,.tsx src/",
    "test": "jest --coverage",
    "test-all": "npm run test && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/median-dxz/Cookie-AutoDelete-MV3.git"
  },
  "author": "median-dxz",
  "contributors": [
    {
      "name": "CAD Team",
      "url": "https://github.com/Cookie-AutoDelete/Cookie-AutoDelete/graphs/contributors"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/median-dxz/Cookie-AutoDelete-MV3/issues"
  },
  "homepage": "https://github.com/median-dxz/Cookie-AutoDelete-MV3#readme"
}
